VITE_EP_VARIACION_CREAR=productovariacion/crear
VITE_EP_VARIACION_ACTUALIZAR=productovariacion/actualizar
VITE_EP_VARIACION_ELIMINAR=productovariacion/eliminar

# ─── PRODUCTO IMAGEN ─────────────────────────────────────────────────────────
