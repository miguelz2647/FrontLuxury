# ─────────────────────────────────────────────────────────────────────────────
# BRUTALSHOES — Variables de entorno
# Copia este archivo y renómbralo según el entorno:
#   .env.local       → desarrollo local
#   .env.test        → pruebas / QA
#   .env.production  → producción
#
# IMPORTANTE: Nunca subas .env.local ni .env.production a git.
# Solo este archivo (.env.example) debe estar en el repositorio.
# ─────────────────────────────────────────────────────────────────────────────

# ─── ENTORNO ──────────────────────────────────────────────────────────────────
VITE_ENV=local                          # local | test | production

# ─── API BASE ─────────────────────────────────────────────────────────────────
VITE_API_URL=https://localhost:7001/api  # URL base de la API sin slash final

# ─── USUARIO ─────────────────────────────────────────────────────────────────
VITE_EP_USUARIO_LOGIN=usuario/login
VITE_EP_USUARIO_REGISTRAR=usuario/registrar
VITE_EP_USUARIO_OBTENER=usuario/obtener
VITE_EP_USUARIO_ACTUALIZAR=usuario/actualizar
VITE_EP_USUARIO_TODOS=usuario/todos

# ─── PRODUCTO ────────────────────────────────────────────────────────────────
VITE_EP_PRODUCTO_TODOS=producto/todos
VITE_EP_PRODUCTO_OBTENER=producto/obtener
VITE_EP_PRODUCTO_POR_CATEGORIA=producto/por-categoria
VITE_EP_PRODUCTO_BUSCAR=producto/buscar
VITE_EP_PRODUCTO_CREAR=producto/crear
VITE_EP_PRODUCTO_ACTUALIZAR=producto/actualizar
VITE_EP_PRODUCTO_ELIMINAR=producto/eliminar

# ─── CATALOGOS ───────────────────────────────────────────────────────────────
